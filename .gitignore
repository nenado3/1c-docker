__pycache__/
*.pyc

# Local environment files and credentials (keep .env.example tracked)
**/.env
**/.env.*
!**/.env.example

# Runtime data, backups, exports and 1C license files
**/backups/
**/export/
**/licenses/
**/certs/
**/*.lic
**/*.dt
**/*.cf
**/*.dump
**/*.log
**/*.part

# Local 1C installer packages are supplied by the operator
**/dist/*.deb
**/dist/*.run

# Local automatic backup scheduler state
**/.backup-schedule.json
**/.backup-schedule.json.tmp
