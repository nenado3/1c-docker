#!/bin/bash
# Запуск GUI-конфигуратора 1С на отдельном виртуальном X-дисплее.
# Использование: 1c-xvfb <команда> [аргументы...]
set -u

if [ "$#" -eq 0 ]; then
    echo "Использование: 1c-xvfb <команда> [аргументы...]" >&2
    exit 2
fi
command -v Xvfb >/dev/null 2>&1 || {
    echo "ОШИБКА: Xvfb не установлен в контейнере" >&2
    exit 90
}

LOG="${XVFB_LOG:-/tmp/xvfb-1c.log}"
DISPLAY_FILE=$(mktemp /tmp/xvfb-display.XXXXXX)
XVFB_PID=""

cleanup() {
    if [ -n "$XVFB_PID" ]; then
        kill "$XVFB_PID" 2>/dev/null || true
        wait "$XVFB_PID" 2>/dev/null || true
    fi
    rm -f "$DISPLAY_FILE"
}
trap cleanup EXIT INT TERM

: > "$LOG"
Xvfb -displayfd 3 -screen 0 1280x1024x24 -nolisten tcp -noreset 3>"$DISPLAY_FILE" >>"$LOG" 2>&1 &
XVFB_PID=$!

DISPLAY_NUMBER=""
for _ in $(seq 1 100); do
    if [ -s "$DISPLAY_FILE" ]; then
        IFS= read -r DISPLAY_NUMBER < "$DISPLAY_FILE"
        break
    fi
    if ! kill -0 "$XVFB_PID" 2>/dev/null; then
        break
    fi
    sleep 0.1
done

if [ -z "$DISPLAY_NUMBER" ] || ! kill -0 "$XVFB_PID" 2>/dev/null; then
    echo "ОШИБКА: Xvfb не смог запустить виртуальный дисплей" >&2
    cat "$LOG" >&2
    exit 90
fi

export DISPLAY=":$DISPLAY_NUMBER"
"$@"
RC=$?
exit "$RC"
